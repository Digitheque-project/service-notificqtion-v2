# ── Port HTTP (Render fournit le sien) ─────────────────────────────
PORT=3005

# ── Base PostgreSQL des notifications (schéma notification) ────────
# Les tables sont créées par le service au démarrage.
DATABASE_URL=

# ── Sécurité ────────────────────────────────────────────────────
# Secret commun de la plateforme : chaque requête et chaque connexion temps réel
# doivent présenter un jeton signé avec lui. Sans lui, le service refuse tout.
JWT_SECRET=

# ── Conservation ──────────────────────────────────────────────────
# Jours conservés avant purge (0 = tout conserver ; l'historique est indexé en base).
NOTIFICATION_RETENTION_DAYS=0
