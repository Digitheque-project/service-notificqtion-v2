# ── Port HTTP ────────────────────────────────────────────────────
PORT=3005

# ── Persistance fichier des notifications ──────────────────────────
# Chemin du fichier JSON (relatif au cwd du process sauf si absolu).
# Le dossier doit etre accessible en ecriture par l'utilisateur du service.
NOTIFICATION_STORE_FILE=data/notifications.json

# ── Retention ─────────────────────────────────────────────────────
# Nombre de jours conserves avant purge automatique (0 = jamais purge).
NOTIFICATION_RETENTION_DAYS=30